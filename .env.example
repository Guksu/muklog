# muklog 환경변수 예시 — 이 파일을 복사해 `.env`로 만들고 실제 값을 채운다.
# `.env`는 .gitignore에 포함되어 커밋되지 않는다.
#
# EXPO_PUBLIC_ 프리픽스는 Expo가 클라이언트 번들에 주입하기 위한 필수 규칙이다.
# anon 키는 공개되어도 안전하다 — 행 수준 보안(RLS)이 실제 접근 통제를 담당한다.
#
# Kakao REST 키는 이번(setup) 스프린트에 없음. 추후 map-tab 스프린트에서
# Supabase Edge Function 환경변수(서버 측)로만 보관한다. 클라이언트에 두지 않는다.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google 소셜 로그인 — OAuth 클라이언트 ID(public, 시크릿 아님 → EXPO_PUBLIC_ 허용).
#   Web client ID: Supabase가 네이티브 idToken 검증 시 audience로 사용(GoogleSignin.configure({ webClientId })).
#   iOS client ID: iOS 네이티브 로그인용(GoogleSignin.configure({ iosClientId })).
#   ※ iOS reversed client ID(역도메인 URL scheme)는 .env가 아니라 app.json의
#     google-signin 플러그인 iosUrlScheme에 직접 입력한다(빌드 시점 값).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Kakao Map JavaScript 키 — map-tab 지도 렌더(WebView + Kakao Map JS SDK)용.
#   ※ REST 키가 아니라 JavaScript 키다(Kakao 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키).
#   ※ JS 키는 도메인 화이트리스트로 보호되는 공개키 성격이라 EXPO_PUBLIC_ 허용. REST 키는 절대 클라에 두지 않는다.
#   ※ 카카오 콘솔 플랫폼에 WebView가 쓰는 origin을 등록해야 지도가 로드된다(dev-notes 절차 참고).
EXPO_PUBLIC_KAKAO_JS_KEY=your-kakao-javascript-key
