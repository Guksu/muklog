{
  "expo": {
    "name": "muklog",
    "slug": "muklog",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "muklog",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/muklog-app-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.muklog.app"
    },
    "android": {
      "package": "com.muklog.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/muklog-app-icon.png",
        "backgroundColor": "#4775F0"
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/muklog-splash.png",
          "backgroundColor": "#EBF1FF",
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 변경하려면 사진 보관함 접근 권한이 필요해요."
        }
      ],
      "./plugins/withFmtConstevalFix"
    ]
  }
}
